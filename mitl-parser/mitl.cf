-- MITL grammar for BNFC (Java backend)
-- Precedence + temporal operators + optional intervals

--------------------------------------------------
-- Program structure
--------------------------------------------------



RankDecl. MitlDecl ::= Ranking ;
MitlFDecl. MitlDecl ::= Mitl ;

MitlSpec. Mitl ::= "MITL_SPEC" ":" MFormula ";" ;
RankFunc. Ranking ::=  "RANKING_FUNCTION" Integer ":" MExpr ";" ;
--------------------------------------------------
-- MFormula precedence
--------------------------------------------------


-- Level 0: IFF (lowest precedence)
MFIff.
MFormula ::= MFormula "<=>" MFormula1 ;
MFBase.
MFormula ::= MFormula1 ;


-- Level 1: IMPLICATION
MFImpl.
MFormula1 ::= MFormula1 "==>" MFormula2 ;
_. MFormula1 ::= MFormula2;

-- Level 2: OR
MFOr.
MFormula2 ::= MFormula2 "||" MFormula3 ;
_. MFormula2 ::= MFormula3;

-- Level 3: TEMPORAL BINARY (UNTIL / SINCE)
MFUntil.
MFormula3 ::= MFormula3 OptRank "U" OptInterval MFormula4 ;

MFSince.
MFormula3 ::= MFormula3 OptRank "S" OptInterval MFormula4 ;

_. MFormula3 ::= MFormula4;

-- Level 4: AND
MFAnd.
MFormula4 ::= MFormula4 "&&" MFormula5 ;
_. MFormula4 ::= MFormula5;

-- Level 5: UNARY (highest precedence)

-- NOT
MFNot.
MFormula5 ::= "!" MFormula5 ;

-- FUTURE operators
MFEventually.
MFormula5 ::= OptRank "F" OptInterval MFormula6 ;

MFGlobally.
MFormula5 ::= OptRank "G" OptInterval MFormula6 ;

-- PAST operators
MFHistorically.
MFormula5 ::= OptRank "H" OptInterval MFormula6 ;

MFOnce.
MFormula5 ::= OptRank "P" OptInterval MFormula6 ;
UnOpBase. MFormula5 ::= MFormula6 ;


-- atomic MFormulas
MFAtom.
MFormula6 ::= MAtom ;

-- parentheses
FPar.
MFormula6 ::= "(" MFormula ")" ;



--------------------------------------------------
-- Optional ranking annotation
--------------------------------------------------

NoRank.
OptRank ::= ;

WithRank.
OptRank ::= "{" Integer "}" ;

--------------------------------------------------
-- Optional interval
--------------------------------------------------

NoInterval.
OptInterval ::= ;

WithInterval.
OptInterval ::= "@" MInterval ;

--------------------------------------------------
-- Intervals
--------------------------------------------------

RightOpenInterval.
MInterval ::= "[" MitlBound "," MitlBound ")" ;
OpenInterval.
MInterval ::= "(" MitlBound "," MitlBound ")" ;
ClosedInterval.
MInterval ::= "[" MitlBound "," MitlBound "]" ;
LeftOpenInterval.
MInterval ::= "(" MitlBound "," MitlBound "]" ;

MitlBoundInt. MitlBound ::= Integer ;
MitlBoundInfty. MitlBound ::= "infty" ;

--------------------------------------------------
-- Atomic predicates
--------------------------------------------------

AtomRel.
MAtom ::= MExpr MRelOp MExpr ;

--------------------------------------------------
-- Arithmetic MExpressions
--------------------------------------------------


-- Level 0: + -
MEAdd.
MExpr ::= MExpr "+" MExpr1 ;

MESub.
MExpr ::= MExpr "-" MExpr1 ;

_. MExpr ::= MExpr1 ;

-- Level 1: *
MEMul.
MExpr1 ::= MExpr1 "*" MExpr2 ;
MEDiv.
MExpr1 ::= MExpr1 "/" MExpr2 ;
_. MExpr1 ::= MExpr2 ;

-- Level 2: atoms
MEVar.
MExpr2 ::= Id ;

MEInt.
MExpr2 ::= Integer ;

MEParen.
MExpr2 ::= "(" MExpr ")" ;




--------------------------------------------------
-- Relational operators
--------------------------------------------------

MRelLt.  MRelOp ::= "<" ;
MRelLe.  MRelOp ::= "<=" ;
MRelGt.  MRelOp ::= ">" ;
MRelGe.  MRelOp ::= ">=" ;
MRelEq.  MRelOp ::= "==" ;
MRelNeq. MRelOp ::= "!=" ;

--------------------------------------------------
-- Tokens
--------------------------------------------------

position token Id (letter | '_' | '$') (letter | digit | '_' | '$')*;

--------------------------------------------------
-- Comments
--------------------------------------------------

comment "//" ;
comment "/*" "*/" ;